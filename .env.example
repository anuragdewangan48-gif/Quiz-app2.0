# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# =========================================================================
# VERCEL DEPLOYMENT & STORAGE CONFIGURATION
# =========================================================================
# The app is fully architected for Vercel's serverless platform.
# Choose either Option A (Recommended: Firebase Firestore) or Option B (Vercel KV):

# -------------------------------------------------------------------------
# OPTION A: Firebase Firestore (Recommended for 100% Serverless Real-Time Sync)
# -------------------------------------------------------------------------
# 1. Create a free project at https://console.firebase.google.com/
# 2. Add a Web App, and enable Firestore Database (Start in test mode or allow read/write).
# 3. In Vercel Dashboard -> Your Project -> Settings -> Environment Variables, add:
VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
VITE_FIREBASE_PROJECT_ID="your-firebase-project-id"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-project-id.firebaseapp.com"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef123456"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"

# NOTE: You can also enter or test these keys directly inside the running app
# by clicking the "Live Sync" badge in the Friend Leaderboard modal!

# -------------------------------------------------------------------------
# OPTION B: Vercel KV / Upstash Redis (For Serverless /api/* Routes)
# -------------------------------------------------------------------------
# 1. In Vercel Dashboard -> Storage -> Create Database -> KV (Upstash Redis)
# 2. Link the database to your project. Vercel automatically populates:
# KV_REST_API_URL="https://your-kv-db.upstash.io"
# KV_REST_API_TOKEN="your-kv-rest-api-token"
